<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <IDA_SDK_DIR></IDA_SDK_DIR>
    <IDA_PROCS_DIR></IDA_PROCS_DIR>
    <IDA_COPY_TO_PLUGINS>false</IDA_COPY_TO_PLUGINS>
  </PropertyGroup>
  <PropertyGroup>
    <idasdklib Condition="$(IDA_SDK_DIR.Contains('8')) ">_pro</idasdklib>
    <idabitness>32</idabitness>
    <idabitness Condition="$(Configuration.EndsWith('64'))">64</idabitness>
    <IncludePath>$(IDA_SDK_DIR)\include;$(IDA_SDK_DIR)\module;$(IncludePath)</IncludePath>
    <LibraryPath>$(IDA_SDK_DIR)\lib\x64_win_vc_$(idabitness)$(idasdklib);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>ida.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ClCompile>
      <PreprocessorDefinitions>__NT__;__IDP__;__X64__;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <ForcedIncludeFiles>pch.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
    <ClCompile Condition="'$(idabitness)'=='64'">
      <PreprocessorDefinitions>__EA64__;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <PostBuildEvent Condition="'$(IDA_COPY_TO_PLUGINS)'=='true'">
      <Command>xcopy $(TargetPath) "$(IDA_PROCS_DIR)" /d /y</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="IDA_SDK_DIR">
      <Value>$(IDA_SDK_DIR)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>